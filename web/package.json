{
  "name": "librepatch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/keep.mjs",
    "test": "vitest run",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@mantine/notifications": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.19",
    "get-nonce": "1.0.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.30",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
