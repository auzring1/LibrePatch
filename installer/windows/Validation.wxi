<?xml version="1.0" encoding="utf-8"?>
<!--
  Character checks for the public properties. MSI conditions have no regular expressions, so this is a
  deny list of every printable ASCII character that the property must not contain, in groups that fit the
  255-character limit of a condition. The agent re-validates SERVER, TOKEN and ALLOWEDJOBS strictly
  (config.FromBundle, config.ParseAllowedJobs). Square brackets are not tested because "[" is special
  in MSI formatted text; the agent rejects them where they are not valid. A literal double quote is
  tested through the DQ property. installer/windows/package_test.go checks the coverage and the lengths.
  Every condition is true when the property is unset, so uninstall and upgrade are never blocked.
-->
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Launch Condition="NOT (SERVER &gt;&lt; DQ OR SERVER &gt;&lt; &quot; &quot; OR SERVER &gt;&lt; &quot;!&quot; OR SERVER &gt;&lt; &quot;#&quot; OR SERVER &gt;&lt; &quot;$&quot; OR SERVER &gt;&lt; &quot;%&quot; OR SERVER &gt;&lt; &quot;&amp;&quot; OR SERVER &gt;&lt; &quot;'&quot;)" Message="SERVER may only contain letters, digits and . - _ : (host:port, for example librepatch.example.com:8443). No quotes, spaces or shell characters." />
  <Launch Condition="NOT (SERVER &gt;&lt; &quot;(&quot; OR SERVER &gt;&lt; &quot;)&quot; OR SERVER &gt;&lt; &quot;*&quot; OR SERVER &gt;&lt; &quot;+&quot; OR SERVER &gt;&lt; &quot;,&quot; OR SERVER &gt;&lt; &quot;/&quot; OR SERVER &gt;&lt; &quot;;&quot; OR SERVER &gt;&lt; &quot;&lt;&quot;)" Message="SERVER may only contain letters, digits and . - _ : (host:port, for example librepatch.example.com:8443). No quotes, spaces or shell characters." />
  <Launch Condition="NOT (SERVER &gt;&lt; &quot;=&quot; OR SERVER &gt;&lt; &quot;&gt;&quot; OR SERVER &gt;&lt; &quot;?&quot; OR SERVER &gt;&lt; &quot;@&quot; OR SERVER &gt;&lt; &quot;\&quot; OR SERVER &gt;&lt; &quot;^&quot; OR SERVER &gt;&lt; &quot;`&quot; OR SERVER &gt;&lt; &quot;{&quot;)" Message="SERVER may only contain letters, digits and . - _ : (host:port, for example librepatch.example.com:8443). No quotes, spaces or shell characters." />
  <Launch Condition="NOT (SERVER &gt;&lt; &quot;|&quot; OR SERVER &gt;&lt; &quot;}&quot; OR SERVER &gt;&lt; &quot;~&quot;)" Message="SERVER may only contain letters, digits and . - _ : (host:port, for example librepatch.example.com:8443). No quotes, spaces or shell characters." />
  <Launch Condition="NOT (TOKEN &gt;&lt; DQ OR TOKEN &gt;&lt; &quot; &quot; OR TOKEN &gt;&lt; &quot;!&quot; OR TOKEN &gt;&lt; &quot;#&quot; OR TOKEN &gt;&lt; &quot;$&quot; OR TOKEN &gt;&lt; &quot;%&quot; OR TOKEN &gt;&lt; &quot;&amp;&quot; OR TOKEN &gt;&lt; &quot;'&quot;)" Message="TOKEN may only contain letters, digits and . - _ . Copy the enrollment string from the console without quotes or spaces." />
  <Launch Condition="NOT (TOKEN &gt;&lt; &quot;(&quot; OR TOKEN &gt;&lt; &quot;)&quot; OR TOKEN &gt;&lt; &quot;*&quot; OR TOKEN &gt;&lt; &quot;+&quot; OR TOKEN &gt;&lt; &quot;,&quot; OR TOKEN &gt;&lt; &quot;/&quot; OR TOKEN &gt;&lt; &quot;:&quot; OR TOKEN &gt;&lt; &quot;;&quot;)" Message="TOKEN may only contain letters, digits and . - _ . Copy the enrollment string from the console without quotes or spaces." />
  <Launch Condition="NOT (TOKEN &gt;&lt; &quot;&lt;&quot; OR TOKEN &gt;&lt; &quot;=&quot; OR TOKEN &gt;&lt; &quot;&gt;&quot; OR TOKEN &gt;&lt; &quot;?&quot; OR TOKEN &gt;&lt; &quot;@&quot; OR TOKEN &gt;&lt; &quot;\&quot; OR TOKEN &gt;&lt; &quot;^&quot; OR TOKEN &gt;&lt; &quot;`&quot;)" Message="TOKEN may only contain letters, digits and . - _ . Copy the enrollment string from the console without quotes or spaces." />
  <Launch Condition="NOT (TOKEN &gt;&lt; &quot;{&quot; OR TOKEN &gt;&lt; &quot;|&quot; OR TOKEN &gt;&lt; &quot;}&quot; OR TOKEN &gt;&lt; &quot;~&quot;)" Message="TOKEN may only contain letters, digits and . - _ . Copy the enrollment string from the console without quotes or spaces." />
  <Launch Condition="NOT (ALLOWEDJOBS &gt;&lt; DQ OR ALLOWEDJOBS &gt;&lt; &quot; &quot; OR ALLOWEDJOBS &gt;&lt; &quot;!&quot; OR ALLOWEDJOBS &gt;&lt; &quot;#&quot; OR ALLOWEDJOBS &gt;&lt; &quot;$&quot; OR ALLOWEDJOBS &gt;&lt; &quot;%&quot; OR ALLOWEDJOBS &gt;&lt; &quot;&amp;&quot; OR ALLOWEDJOBS &gt;&lt; &quot;'&quot;)" Message="ALLOWEDJOBS may only contain lower-case letters, digits, _ and commas, for example inventory,wu_scan." />
  <Launch Condition="NOT (ALLOWEDJOBS &gt;&lt; &quot;(&quot; OR ALLOWEDJOBS &gt;&lt; &quot;)&quot; OR ALLOWEDJOBS &gt;&lt; &quot;*&quot; OR ALLOWEDJOBS &gt;&lt; &quot;+&quot; OR ALLOWEDJOBS &gt;&lt; &quot;-&quot; OR ALLOWEDJOBS &gt;&lt; &quot;.&quot; OR ALLOWEDJOBS &gt;&lt; &quot;/&quot; OR ALLOWEDJOBS &gt;&lt; &quot;:&quot;)" Message="ALLOWEDJOBS may only contain lower-case letters, digits, _ and commas, for example inventory,wu_scan." />
  <Launch Condition="NOT (ALLOWEDJOBS &gt;&lt; &quot;;&quot; OR ALLOWEDJOBS &gt;&lt; &quot;&lt;&quot; OR ALLOWEDJOBS &gt;&lt; &quot;=&quot; OR ALLOWEDJOBS &gt;&lt; &quot;&gt;&quot; OR ALLOWEDJOBS &gt;&lt; &quot;?&quot; OR ALLOWEDJOBS &gt;&lt; &quot;@&quot; OR ALLOWEDJOBS &gt;&lt; &quot;\&quot; OR ALLOWEDJOBS &gt;&lt; &quot;^&quot;)" Message="ALLOWEDJOBS may only contain lower-case letters, digits, _ and commas, for example inventory,wu_scan." />
  <Launch Condition="NOT (ALLOWEDJOBS &gt;&lt; &quot;`&quot; OR ALLOWEDJOBS &gt;&lt; &quot;{&quot; OR ALLOWEDJOBS &gt;&lt; &quot;|&quot; OR ALLOWEDJOBS &gt;&lt; &quot;}&quot; OR ALLOWEDJOBS &gt;&lt; &quot;~&quot;)" Message="ALLOWEDJOBS may only contain lower-case letters, digits, _ and commas, for example inventory,wu_scan." />
</Include>
