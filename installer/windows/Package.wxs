<?xml version="1.0" encoding="utf-8"?>
<!--
  LibrePatch Agent MSI: a THIN WRAPPER around `librepatch-agent.exe install` / `uninstall`
  (docs/DECISIONS.md O6, D67). WiX v7, "v4+ style" schema. Build: installer/windows/build.ps1.

  What the MSI does
    * installs the (already signed) agent exe into a SETUP directory, [ProgramFiles64Folder]LibrePatchSetup\
      (deliberately NOT under ...\LibrePatch\Agent: `librepatch-agent uninstall` deletes that tree, and an
      exe that is running from inside it can only be removed at the next reboot);
    * a deferred, SYSTEM-context custom action runs `librepatch-agent.exe install` (with its if-not-installed flag),
      which copies the binary to slot-a, creates the service and enrolls;
    * on uninstall a deferred custom action runs `librepatch-agent.exe uninstall` (service, data, files);
      MSI then removes the staged exe. Major upgrades do NOT run it (see UPGRADINGPRODUCTCODE).

  Hard rules (checked by installer/windows/package_test.go):
    * no cmd.exe, no PowerShell, no script custom action: the agent exe is started directly by
      WixSilentExec64, which neither logs the command line nor the child's output;
    * TOKEN is a secret: it is in MsiHiddenProperties, together with every property that carries it
      (KNOWN LIMIT, D103: Windows Installer still prints the install action's data, token included, in a
      /l*v log on the line "Executing op: CustomActionSchedule(Action=InstallAgent"; the owner accepted it)
      (the CustomActionData of InstallAgent), and it reaches the elevated action only as CustomActionData.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef Version?>
  <?error Define Version (numeric a.b.c.d), e.g. wix build -d Version=1.2.3.0?>
  <?endif?>
  <?ifndef AgentName?>
  <?error Define ProductName, AgentName, Company, ServiceName and SetupFolder (installer/windows/build.ps1 and scripts/build-msi.sh pass them from internal/shared/brand)?>
  <?endif?>
  <?ifndef AgentExe?>
  <?error Define AgentExe (path to the signed librepatch-agent.exe), e.g. wix build -d AgentExe=librepatch-agent.exe?>
  <?endif?>

  <Package Name="$(AgentName)"
           Manufacturer="$(Company)"
           Version="$(Version)"
           UpgradeCode="BC09578F-DD80-4ACD-AD99-4A52AF895AC5"
           Scope="perMachine"
           InstallerVersion="500"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Description="$(ProductName) endpoint management agent (installs, enrolls and starts the $(ServiceName) service)" />

    <!-- An MSI upgrade of an already enrolled machine keeps the service, device key and data:
         the old product's uninstall action is skipped (UPGRADINGPRODUCTCODE) and the new install
         action runs `install` with its if-not-installed flag, which exits 0 when the machine is enrolled. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of the $(AgentName) MSI is already installed. To go back to an older version, uninstall first (this removes the device from this machine; it must then be enrolled again)."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!-- ===== Public properties: the whole interface of the MSI ===== -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="TOKEN" Secure="yes" Hidden="yes" />
    <Property Id="ALLOWEDJOBS" Secure="yes" />
    <!-- ALLOWSCRIPTS=1 lets administrators run PowerShell scripts on this computer from the console (off by default, D127). -->
    <Property Id="ALLOWSCRIPTS" Secure="yes" />

    <!-- Properties that must never be written to a verbose log. TOKEN is the enrollment secret;
         AgentArgsToken and InstallAgent carry it into the deferred action (CustomActionData);
         Hidden="yes" puts them in MsiHiddenProperties. -->
    <Property Id="AgentArgsToken" Hidden="yes" />
    <Property Id="InstallAgent" Hidden="yes" />

    <!-- A literal double quote, for the validation conditions (a quote cannot be written inside an MSI string). -->
    <Property Id="DQ" Value="&quot;" />

    <!-- Is the service already registered? Evaluated before any change, so the rollback action
         can tell a fresh install (clean up on failure) from an enrolled machine (never touch). -->
    <Property Id="AGENTSERVICEPATH" Secure="yes">
      <RegistrySearch Id="AgentServiceImagePath" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\$(ServiceName)" Name="ImagePath" Type="raw" Bitness="always64" />
    </Property>

    <!-- The real Windows build number. VersionNT and WindowsBuild cannot be used for the version check: Windows Installer
         can report Windows 8.1 (VersionNT 603, WindowsBuild 9600) on Windows 10/11 and Server (seen on a Windows 11 test
         machine), which made the 1809 launch condition fail. CurrentBuildNumber is the number winver shows. -->
    <Property Id="WINBUILD">
      <RegistrySearch Id="WindowsBuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>

    <!-- Add/Remove Programs -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="$(ProductName) endpoint management agent" />

    <!-- ===== Platform conditions ===== -->
    <Launch Condition="Installed OR VersionNT64" Message="The $(AgentName) supports 64-bit (x64) Windows only." />
    <Launch Condition="Installed OR WINBUILD &gt;= 17763" Message="The $(AgentName) requires Windows 10 version 1809 (build 17763) or later, or Windows Server 2019 or later." />
    <Launch Condition="Installed OR Privileged" Message="The $(AgentName) must be installed by an administrator (run msiexec from an elevated prompt, or deploy it as SYSTEM)." />

    <!-- ===== Required properties on a first install (not on uninstall, and not when the machine is already enrolled) ===== -->
    <Launch Condition="Installed OR AGENTSERVICEPATH OR SERVER" Message="SERVER is required for the first installation, for example SERVER=librepatch.example.com:8443." />
    <Launch Condition="Installed OR AGENTSERVICEPATH OR TOKEN" Message="TOKEN is required for the first installation: the enrollment string from the console (it starts with LP1.)." />

    <!-- Character checks: SERVER, TOKEN and ALLOWEDJOBS must not contain quotes, spaces or shell metacharacters. -->
    <?include Validation.wxi?>

    <!-- Shape checks (the character checks are in Validation.wxi). The agent validates everything again. -->
    <Launch Condition="NOT SERVER OR SERVER &gt;&lt; &quot;:&quot;" Message="SERVER must be host:port, for example librepatch.example.com:8443." />
    <Launch Condition="NOT TOKEN OR TOKEN &lt;&lt; &quot;LP1.&quot;" Message="TOKEN is not a $(ProductName) enrollment string (it must start with LP1.). Copy the whole string from the console." />

    <!-- ===== Files ===== -->
    <?ifdef LinuxLint?>
    <!-- Source lint on Linux only (scripts/lint-wxs.sh): the WiX compiler on Linux rejects every relative
         Directory name (WIX0389) and cannot bind an MSI (no msi.dll). Never used for a real build. -->
    <Property Id="SetupDir" Value="C:\$(SetupFolder)\" />
    <Component Id="AgentSetupExe" Guid="*" Directory="ProgramFiles64Folder" Bitness="always64">
      <File Id="AgentExe" Name="librepatch-agent.exe" Source="$(AgentExe)" KeyPath="yes" />
    </Component>
    <?else?>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="SetupDir" Name="$(SetupFolder)">
        <Component Id="AgentSetupExe" Guid="*" Bitness="always64">
          <File Id="AgentExe" Name="librepatch-agent.exe" Source="$(AgentExe)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <?endif?>

    <Feature Id="Agent" Title="$(AgentName)" Level="1">
      <ComponentRef Id="AgentSetupExe" />
    </Feature>

    <!-- ===== Custom actions: run librepatch-agent.exe directly, in SYSTEM context =====
         WixSilentExec64 needs the command line to BEGIN with the quoted exe path. It reads the
         command line from CustomActionData (the property named like the action). It logs neither the
         command line nor the child's output. (Windows Installer itself does log the action's data in a /l*v log: D103.) -->
    <CustomAction Id="InstallAgent" DllEntry="WixSilentExec64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Undoes a fresh install that failed (bad token, server unreachable, ...): removes the service,
         data and files. Only scheduled when no agent existed before this run. -->
    <CustomAction Id="RollbackInstallAgent" DllEntry="WixSilentExec64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="UninstallAgent" DllEntry="WixSilentExec64" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Command lines. Optional parts are separate properties so that nothing is passed when unset.
         Values were validated by the launch conditions (no quotes, spaces or shell metacharacters). -->
    <SetProperty Id="AgentArgsServer" Value=" --server [SERVER]" Sequence="execute" After="CostFinalize" Condition="NOT Installed AND SERVER" />
    <SetProperty Id="AgentArgsToken" Value=" --token [TOKEN]" Sequence="execute" After="SetAgentArgsServer" Condition="NOT Installed AND TOKEN" />
    <SetProperty Id="AgentArgsJobs" Value=" --allowed-jobs [ALLOWEDJOBS]" Sequence="execute" After="SetAgentArgsToken" Condition="NOT Installed AND ALLOWEDJOBS" />
    <SetProperty Id="AgentArgsScripts" Value=" --allow-scripts" Sequence="execute" After="SetAgentArgsJobs" Condition="NOT Installed AND ALLOWSCRIPTS=&quot;1&quot;" />
    <SetProperty Id="InstallAgent" Value="&quot;[SetupDir]librepatch-agent.exe&quot; install --if-not-installed[AgentArgsServer][AgentArgsToken][AgentArgsJobs][AgentArgsScripts]" Sequence="execute" After="SetAgentArgsScripts" Condition="NOT Installed" />
    <SetProperty Id="RollbackInstallAgent" Value="&quot;[SetupDir]librepatch-agent.exe&quot; uninstall" Sequence="execute" After="CostFinalize" Condition="NOT Installed AND NOT AGENTSERVICEPATH" />
    <SetProperty Id="UninstallAgent" Value="&quot;[SetupDir]librepatch-agent.exe&quot; uninstall" Sequence="execute" After="CostFinalize" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

    <InstallExecuteSequence>
      <!-- Rollback action first (rollback runs in reverse order, so it runs after InstallAgent failed
           and before the staged files are removed again). -->
      <Custom Action="RollbackInstallAgent" After="InstallFiles" Condition="NOT Installed AND NOT AGENTSERVICEPATH" />
      <Custom Action="InstallAgent" After="RollbackInstallAgent" Condition="NOT Installed" />
      <!-- Not on a major upgrade (UPGRADINGPRODUCTCODE is set while the OLD product is removed). -->
      <Custom Action="UninstallAgent" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
