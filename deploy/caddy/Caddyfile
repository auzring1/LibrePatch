# Browser-facing TLS for the web console and REST API only.
# Agents connect to the server's gateway on :8443 directly (mTLS terminated by
# the server itself) and never pass through this proxy.
{
	admin off
	# Read-only container: never try to install Caddy's root into a system store.
	skip_install_trust
}

{$LIBREPATCH_HOSTNAME} {
	# "internal" = Caddy's own CA (LAN installs); an email address = Let's Encrypt (ACME).
	tls {$LIBREPATCH_CADDY_TLS}
	encode zstd gzip
	# Installer and agent-release uploads are the only large request bodies.
	@upload path /api/v1/catalog/content /api/v1/agent-releases
	request_body @upload {
		max_size 2GB
	}
	@api not path /api/v1/catalog/content /api/v1/agent-releases
	request_body @api {
		max_size 1MB
	}
	reverse_proxy server:8080 {
		# Caddy appends the client IP to X-Forwarded-For; the server trusts it
		# only from the frontend network (LIBREPATCH_TRUSTED_PROXIES).
		header_down -Server
	}
	header -Server
}
